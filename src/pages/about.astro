---
/**
 * About: Nev in full. All content lives in src/data/about.ts, taken from his own pages (GUE
 * instructor résumé, nevcan.com, LinkedIn); nothing here is invented.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import GueCard from '@/components/about/GueCard.astro';
import {
  intro,
  stats,
  roles,
  education,
  qualifications,
  ambassador,
  publications,
  interests,
  software,
  languages,
  memberships,
} from '@/data/about';
---

<BaseLayout
  title="About"
  description="Nevcan Uludaş: GUE Instructor Trainer, founder of GUE TR, owner of Neptün Sualtı Merkezi, underwater cultural heritage researcher and software architect."
>
  {/* banner: Nev on a reef wall, torch on the soft corals (credited to GUE) */}
  <div class="banner">
    <img
      src="/media/about-reef-1280.webp"
      srcset="/media/about-reef-1280.webp 1280w, /media/about-reef-1920.webp 1920w, /media/about-reef-2560.webp 2560w"
      sizes="100vw"
      alt=""
      width="2560"
      height="1707"
      fetchpriority="high"
    />
    <p class="banner-credit">Photo: Global Underwater Explorers</p>
  </div>
  <article class="page">
    <header class="head">
      <span class="ring">
        <img
          src="/media/nev-portrait-384.webp"
          alt="Nevcan Uludaş"
          width="192"
          height="192"
          fetchpriority="high"
        />
      </span>
      <div class="head-copy">
        <p class="eyebrow">About</p>
        <h1>Hello, I’m Nev</h1>
        {intro.map((p) => (
          <p class="lede">{p}</p>
        ))}
      </div>
    </header>

    <ul class="stats" aria-label="Diving in numbers">
      {stats.map((s) => (
        <li class="stat lg lg-dark">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </li>
      ))}
    </ul>

    <section class="block">
      <h2>
        <span class="eyebrow">Experience</span>What I do
      </h2>
      <ul class="cards">
        {roles.map((r) => (
          <li class="card lg lg-dark">
            <span class="card-title">{r.title}</span>
            <span class="card-where">
              {r.href ? (
                <a href={r.href} target="_blank" rel="noopener">
                  {r.where}
                </a>
              ) : (
                r.where
              )}
            </span>
            {r.note && <span class="card-note">{r.note}</span>}
            {(r.since ?? r.when) && <span class="card-meta">{r.since ?? r.when}</span>}
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2>
        <span class="eyebrow">Qualifications</span>Cards and ratings
      </h2>
      <GueCard />
      <div class="quals">
        {qualifications.map((q) => (
          <div class="panel lg lg-dark">
            <h3>
              {q.group}
              {q.sub && <span class="h3-sub">{q.sub}</span>}
            </h3>
            <ul class="list">
              {q.items.map((i) => (
                <li>
                  {/* the ★ of "2★" small and raised, like an exponent */}
                  {i.split('★').map((part, k) => (
                    <>
                      {k > 0 && <span class="star">★</span>}
                      {part}
                    </>
                  ))}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="note">
        Instructor member of{' '}
        {memberships.map((m, i) => (
          <>
            {i > 0 && ', '}
            {m.org} (since {m.since})
          </>
        ))}
        .
      </p>
    </section>

    <section class="block split">
      <div>
        <h2>
          <span class="eyebrow">Education</span>Degrees
        </h2>
        <ul class="rows">
          {education.map((e) => (
            <li>
              <span class="row-main">{e.degree}</span>
              <span class="row-meta">
                {e.school} · {e.year}
              </span>
              {e.note && <span class="row-note">{e.note}</span>}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2>
          <span class="eyebrow">Languages</span>I teach in
        </h2>
        <ul class="langs">
          {languages.map((l) => (
            <li class="lang lg lg-dark">
              <span class="lang-code" aria-hidden="true">
                {l.code}
              </span>
              <span class="lang-name">{l.name}</span>
              <span class="lang-level">
                <span class="dots" aria-hidden="true">
                  {Array.from({ length: 5 }, (_, i) => (
                    <span class:list={['dot', { on: i < l.dots }]} />
                  ))}
                </span>
                {l.level}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="block split">
      <div>
        <h2>
          <span class="eyebrow">Brand</span>Ambassador
        </h2>
        <ul class="tags tags-lg">
          {ambassador.map((a) => (
            <li>{a}</li>
          ))}
        </ul>
      </div>
      <div>
        <h2>
          <span class="eyebrow">Words</span>Publications
        </h2>
        <ul class="rows">
          {publications.map((p) => (
            <li class="pub">
              <span class="pub-icon" aria-hidden="true">
                {p.kind === 'video' ? (
                  /* a screen with a play button */
                  <svg viewBox="0 0 24 24">
                    <rect x="2.5" y="4.5" width="19" height="15" rx="3" />
                    <path d="M10 9.2v5.6l4.8-2.8z" fill="currentColor" stroke-linejoin="round" />
                  </svg>
                ) : (
                  /* an open book */
                  <svg viewBox="0 0 24 24">
                    <path d="M12 6.5C10 5 7 4.5 3 5v13c4-.5 7 0 9 1.5 2-1.5 5-2 9-1.5V5c-4-.5-7 0-9 1.5z" />
                    <path d="M12 6.5v13" />
                  </svg>
                )}
              </span>
              <span class="row-main">
                {p.href ? (
                  <a
                    href={p.href}
                    target="_blank"
                    rel={p.href.includes('via=nev') ? 'noopener sponsored' : 'noopener'}
                  >
                    {p.title}
                  </a>
                ) : (
                  p.title
                )}
              </span>
              <span class="row-meta">
                {p.where}
                {p.year && ` · ${p.year}`}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="block split">
      <div>
        <h2>
          <span class="eyebrow">The other half</span>Software
        </h2>
        <p class="body">{software.text}</p>
        <ul class="rows">
          {software.steps.map((s) => (
            <li>
              <span class="row-main">{s.what}</span>
              <span class="row-meta">{s.when}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2>
          <span class="eyebrow">Curious about</span>Interests
        </h2>
        <ol class="interests">
          {interests.map((i, n) => (
            <li>
              <span class="interest-n" aria-hidden="true">
                {String(n + 1).padStart(2, '0')}
              </span>
              {i}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="cta panel lg lg-dark">
      <h2>Want to dive together?</h2>
      <p>Courses, training and project dives, in Istanbul, Dubai and wherever the project is.</p>
      <div class="cta-links">
        <a class="btn" href="/booking">
          Let’s plan a dive →
        </a>
        <a class="link" href="mailto:nev@gue.com">
          nev@gue.com
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  /* full-bleed photo; the head (portrait + title) rises onto its lower, open-water part */
  .banner {
    position: relative;
    height: clamp(24rem, 72svh, 46rem);
    overflow: hidden;
  }
  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 40%;
  }
  /* set vertically in the corner, like the homepage's clip credits */
  .banner-credit {
    position: absolute;
    z-index: 1;
    left: max(6px, calc(var(--gutter) / 2 - 0.5em));
    bottom: var(--space-6);
    margin: 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(232 244 248 / 0.55);
    text-shadow: 0 0 8px rgb(1 5 10 / 0.6);
  }
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(1 8 16 / 0.55), transparent 22%),
      linear-gradient(to top, var(--depth-120) 2%, rgb(1 8 16 / 0.55) 30%, transparent 60%);
  }
  .page {
    position: relative;
    display: grid;
    gap: var(--space-9);
    max-width: var(--content-max);
    margin: clamp(-15rem, -22svh, -9rem) auto 0;
    padding: 0 var(--gutter) var(--space-10);
  }
  @media (min-width: 900px) {
    .page {
      padding-right: calc(var(--gutter) + 5.5rem);
    }
  }
  a {
    color: var(--bio);
    text-decoration: none;
  }
  /* links inside running text are underlined too, not told apart by colour alone */
  p a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .eyebrow {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--bio);
  }

  /* head: the leaf-framed portrait (as on the homepage) beside the intro */
  .head {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 760px) {
    .head {
      grid-template-columns: auto minmax(0, 46rem);
      gap: var(--space-8);
    }
  }
  .ring {
    display: block;
    width: max-content;
    padding: 0.55rem;
    border-radius: 50% 10%;
    line-height: 0;
    background: rgb(255 255 255 / 0.08);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      inset 0 0 0 1px rgb(255 255 255 / 0.18),
      0 18px 50px rgb(1 8 16 / 0.45);
  }
  .ring img {
    display: block;
    width: clamp(8rem, 6rem + 6vw, 12rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50% 35%;
    object-fit: cover;
    object-position: 50% 28%;
  }
  .head-copy {
    display: grid;
    gap: var(--space-4);
    text-shadow: 0 2px 24px rgb(1 8 16 / 0.6);
  }
  h1 {
    font-size: var(--step-6);
    line-height: 1;
  }
  .lede {
    font-size: var(--step-0);
    line-height: var(--leading-body);
    color: rgb(232 244 248 / 0.88);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .stats {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .stat {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5);
    border-radius: 20px;
  }
  .stat-value {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .block {
    display: grid;
    gap: var(--space-5);
  }
  .split {
    gap: var(--space-8);
  }
  .narrow {
    max-width: 46rem;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  h2 {
    font-size: var(--step-4);
    line-height: 1.05;
    margin-bottom: var(--space-4);
  }
  .block > h2 {
    margin-bottom: 0;
  }
  h3 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
  }
  /* "other agencies" under a qualification group's title: grey, smaller, a subtitle */
  .h3-sub {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-text);
    font-size: var(--step--1);
    line-height: 1.3;
    color: var(--ink-muted);
  }
  .sub {
    margin: var(--space-6) 0 var(--space-3);
    font-size: var(--step-1);
  }
  .note,
  .body {
    color: rgb(232 244 248 / 0.8);
  }
  .body {
    margin-bottom: var(--space-4);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    padding: var(--space-5);
    border-radius: 20px;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .card-where {
    color: rgb(232 244 248 / 0.85);
  }
  /* a quiet aside under the place: grey like the dates, a touch smaller, italic */
  .card-note {
    font-size: 0.8rem;
    font-style: italic;
    color: var(--ink-muted);
  }
  .card-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* languages: a monogram badge, the name, and a five-dot level */
  .langs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lang {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-4);
    row-gap: 2px;
    align-items: center;
    padding: var(--space-5);
    border-radius: 20px;
  }
  .lang-code {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--bio);
    background: rgb(111 247 224 / 0.08);
    box-shadow: inset 0 0 0 1px rgb(111 247 224 / 0.35);
  }
  .lang-name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
  }
  /* dots above the level: side by side, "Professional" didn't fit next to them and wrapped */
  .lang-level {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .star {
    font-size: 0.6em;
    line-height: 0;
    vertical-align: 0.6em;
    margin-left: 0.05em;
  }
  .dots {
    display: inline-flex;
    gap: 4px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(232 244 248 / 0.18);
  }
  .dot.on {
    background: var(--bio);
  }

  /* interests: an editorial index, numbered, in the display face */
  .interests {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .interests li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: baseline;
    padding-block: var(--space-3);
    border-top: 1px solid var(--glass-border);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .interests li:last-child {
    border-bottom: 1px solid var(--glass-border);
  }
  .interest-n {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--bio);
  }

  .panel {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-6);
    border-radius: 24px;
  }
  .panel p {
    color: rgb(232 244 248 / 0.85);
  }
  /* four groups: one row on wide screens, two by two on tablets, stacked on phones */
  .quals {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 760px) {
    .quals {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .quals {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .quals .panel {
      padding: var(--space-5);
    }
  }
  .list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    color: rgb(232 244 248 / 0.88);
  }
  .list li::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 10px;
    border-radius: 50%;
    vertical-align: 2px;
    background: var(--bio);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.35em 0.9em;
    border-radius: var(--radius-pill);
    font-size: var(--step--1);
    background: rgb(232 244 248 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(232 244 248 / 0.16);
  }
  .tags-lg li {
    font-size: var(--step-0);
    padding: 0.45em 1.1em;
  }

  .rows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows li {
    display: grid;
    gap: 2px;
    padding-block: var(--space-3);
    border-top: 1px solid var(--glass-border);
  }
  .row-main {
    font-size: var(--step-0);
  }
  .row-meta,
  .row-note {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  /* publications: a small icon in front of each (video / book), the text beside it */
  .rows li.pub {
    grid-template-columns: auto 1fr;
    column-gap: var(--space-3);
    align-items: center;
  }
  .pub > :not(.pub-icon) {
    grid-column: 2;
  }
  .pub-icon {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    background: rgb(255 255 255 / 0.04);
    color: var(--bio);
  }
  .pub-icon svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cta {
    justify-items: start;
    padding: var(--space-8);
  }
  .cta h2 {
    margin: 0;
  }
  .cta-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }
  .btn {
    padding: 0.8rem 1.4rem;
    border-radius: var(--radius-pill);
    font-weight: 500;
    color: var(--ink-surface);
    background: var(--bio);
  }
  .btn:hover {
    text-decoration: none;
    filter: brightness(1.08);
  }
</style>
