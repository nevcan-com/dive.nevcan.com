---
import { journey } from '@/data/journey';
import { MAX_DEPTH } from './depth';

const label = (eyebrow: string) => eyebrow.split('·').at(-1)?.trim() ?? eyebrow;
// chapters, then Contact at the bottom of the journey
const stops = [
  ...journey.map((s) => ({ id: s.id, label: label(s.eyebrow), depth: s.depthStart })),
  { id: 'contact', label: 'Contact', depth: MAX_DEPTH },
];
---

<nav class="rail" aria-label="Depth navigation">
  <div class="track lg" aria-hidden="true">
    <span class="fill"></span>
  </div>
  <ol class="ticks">
    {stops.map((s) => (
      <li style={`--at:${s.depth / MAX_DEPTH}`}>
        <a href={`#${s.id}`} data-tick={s.id}>
          <span class="tick-label lg lg-dark">
            {s.label}
            <span class="tick-depth">{s.depth} m</span>
          </span>
          <span class="tick-mark" aria-hidden="true" />
        </a>
      </li>
    ))}
  </ol>
  <div class="needle" aria-hidden="true">
    <span class="readout lg lg-dark">
      <span data-depth-value>000</span>
      <small>m</small>
    </span>
    <span class="drop lg">
      <span class="core"></span>
    </span>
  </div>
</nav>

<script>
  const value = document.querySelector<HTMLElement>('[data-depth-value]');
  const ticks = new Map(
    Array.from(document.querySelectorAll<HTMLElement>('[data-tick]')).map((el) => [
      el.dataset.tick!,
      el,
    ]),
  );
  let active = '';
  window.addEventListener('divedepth', (e) => {
    const { depth, section } = e.detail;
    if (value) value.textContent = String(Math.round(depth)).padStart(3, '0');
    if (section !== active) {
      ticks.get(active)?.removeAttribute('aria-current');
      ticks.get(section)?.setAttribute('aria-current', 'location');
      active = section;
    }
  });
</script>

<style>
  .rail {
    --top: 5.25rem;
    --bottom: var(--space-5);
    --w: 12px;
    position: fixed;
    top: var(--top);
    bottom: var(--bottom);
    right: var(--space-5);
    z-index: var(--z-hud);
    width: var(--w);
    font-family: var(--font-mono);
    color: var(--ink);
    pointer-events: none;
  }

  /* glass capsule track; the part already descended fills with a faint light */
  .track {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-pill);
    --lg-blur: 10px;
    --lg-alpha: 0.05;
    overflow: hidden;
  }
  .fill {
    position: absolute;
    inset: 0 0 auto 0;
    height: calc(var(--depth-m, 0) / 120 * 100%);
    background: linear-gradient(to bottom, rgb(111 247 224 / 0.05), rgb(111 247 224 / 0.28));
    border-radius: inherit;
  }

  .ticks {
    position: absolute;
    inset: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ticks li {
    position: absolute;
    right: 0;
    top: calc(var(--at) * 100%);
    transform: translateY(-50%);
  }
  .ticks a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 6px 0 6px var(--space-3);
    text-decoration: none;
    pointer-events: auto;
  }
  .tick-mark {
    display: block;
    width: var(--w);
    height: 1px;
    background: rgb(232 244 248 / 0.55);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .ticks a[aria-current] .tick-mark,
  .ticks a:hover .tick-mark {
    background: var(--bio);
  }

  .tick-label {
    display: grid;
    justify-items: end;
    gap: 1px;
    padding: 5px 10px;
    border-radius: 10px;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink);
    opacity: 0;
    transform: translateX(8px) scale(0.96);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .tick-depth {
    color: var(--ink-muted);
    letter-spacing: 0.06em;
  }
  .ticks a:hover .tick-label,
  .ticks a:focus-visible .tick-label {
    opacity: 1;
    transform: none;
  }
  .ticks a:focus-visible {
    outline: none;
  }
  .ticks a:focus-visible .tick-label {
    outline: 2px solid var(--bio);
  }

  /* the needle: a glass droplet riding the track, with a readout beside it */
  .needle {
    position: absolute;
    right: calc(var(--w) / 2 - 15px);
    top: calc(var(--depth-m, 0) / 120 * 100%);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    transform: translateY(-50%);
  }
  .drop {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    /* accent-tinted glass around the accent core */
    --lg-rgb: 111 247 224;
    --lg-alpha: 0.28;
    --lg-blur: 6px;
  }
  .core {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bio);
    box-shadow:
      0 0 10px var(--bio),
      0 0 2px #fff;
  }
  .readout {
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .readout small {
    margin-left: 0.25em;
    color: var(--ink-muted);
  }

  @media (max-width: 640px) {
    .rail {
      --top: 4.75rem;
      --bottom: var(--space-4);
      --w: 8px;
      right: 8px;
    }
    .needle {
      right: calc(var(--w) / 2 - 12px);
    }
    .drop {
      width: 24px;
      height: 24px;
    }
    /* on phones the droplet's position is the readout; the number would sit on the text */
    .readout {
      display: none;
    }
  }
</style>
