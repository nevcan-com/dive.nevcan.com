---
/**
 * The current chapter's footage credit, set vertically in the bottom-left corner (like a film
 * credit on the frame). It follows the chapter in view and steps aside during transitions.
 */
import { journey } from '@/data/journey';

const credits = Object.fromEntries(journey.filter((c) => c.credit).map((c) => [c.id, c.credit]));
---

<p class="clip-credit" data-clip-credit data-credits={JSON.stringify(credits)}></p>

<script>
  import { segmentAt, OUTRO_START, SHARK_FROM } from './cinematics';

  const el = document.querySelector<HTMLElement>('[data-clip-credit]');
  if (el) {
    const credits = JSON.parse(el.dataset.credits ?? '{}') as Record<string, string>;
    let shown = '';
    window.addEventListener('divedepth', (e) => {
      const { depth, section } = e.detail;
      // hidden while a transition plays, and once the lights go out for the outro:
      // the credit belongs to the clip on screen
      // the outro's shark is a CC BY model: credited for as long as it swims
      const text =
        depth >= SHARK_FROM
          ? '3D shark: LasquetiSpice · CC BY 4.0'
          : segmentAt(depth).to || depth > OUTRO_START
            ? ''
            : (credits[section] ?? '');
      if (text === shown) return;
      shown = text;
      if (!text) {
        el.classList.remove('is-on');
        return;
      }
      el.textContent = text;
      el.classList.add('is-on');
    });
  }
</script>

<style>
  .clip-credit {
    position: fixed;
    left: max(6px, calc(var(--gutter) / 2 - 0.5em));
    bottom: var(--space-6);
    z-index: 3;
    margin: 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(232 244 248 / 0.55);
    text-shadow: 0 0 8px rgb(1 5 10 / 0.6);
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }
  .clip-credit.is-on {
    opacity: 1;
  }
</style>
