---
/**
 * Cookie consent: a banner on the first visit (Accept / Reject / Preferences, equal weight) and
 * the preferences dialog, which the footer's "Cookie settings" opens later ([data-cc-open]).
 * Nothing optional runs before a choice; without JavaScript nothing shows and nothing loads.
 */
---

<section class="cc lg lg-dark" aria-labelledby="cc-title" data-cc-banner hidden>
  <div class="cc-text">
    <h2 id="cc-title">Cookies, only if you agree</h2>
    <p>
      With your consent, this site uses Google Analytics to see which pages are visited. No
      advertising. Accepting also sends this data to Google in the US, which Türkiye has not found
      to protect data adequately; US authorities may be able to access it.{' '}
      <a href="/privacy#analytics">How analytics works</a>
    </p>
  </div>
  <div class="cc-actions">
    <button class="cc-btn" type="button" data-cc-accept>
      Accept
    </button>
    <button class="cc-btn" type="button" data-cc-reject>
      Reject
    </button>
    <button class="cc-btn" type="button" data-cc-open>
      Preferences
    </button>
  </div>
</section>

<dialog class="cc-dialog lg lg-dark" aria-labelledby="cc-dialog-title" data-cc-dialog>
  <button class="close" type="button" aria-label="Close" data-cc-close>
    ×
  </button>
  <h2 id="cc-dialog-title">Cookie settings</h2>
  <p>Choose what this site may store. You can change this at any time in the footer.</p>

  <ul class="cc-list">
    <li>
      <div>
        <p class="cc-name">Necessary</p>
        <p class="cc-desc">Remembers your choice here, in your browser. Needs no consent.</p>
      </div>
      <span class="cc-always">Always on</span>
    </li>
    <li>
      <label class="cc-name" for="cc-analytics">
        Analytics
      </label>
      <p class="cc-desc" id="cc-analytics-desc">
        Google Analytics: which pages are visited, device type and approximate location. Cookies
        dive_ga, dive_ga_…, up to two years. <a href="/privacy#analytics">Details</a>
      </p>
      <input
        class="cc-switch"
        type="checkbox"
        role="switch"
        id="cc-analytics"
        aria-describedby="cc-analytics-desc"
        data-cc-analytics
      />
    </li>
  </ul>

  <div class="cc-actions">
    <button class="cc-btn" type="button" data-cc-reject>
      Reject all
    </button>
    <button class="cc-btn" type="button" data-cc-save>
      Save choice
    </button>
  </div>
</dialog>

<script>
  import { applyChoice, readChoice, saveChoice } from './consent';

  const banner = document.querySelector<HTMLElement>('[data-cc-banner]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-cc-dialog]');

  if (banner && dialog) {
    const toggle = dialog.querySelector<HTMLInputElement>('[data-cc-analytics]')!;
    const initial = readChoice();
    applyChoice(initial);
    banner.hidden = !!initial;

    const choose = (analytics: boolean) => {
      applyChoice(saveChoice(analytics));
      banner.hidden = true;
      if (dialog.open) dialog.close();
    };

    // the footer's "Cookie settings" and the banner's "Preferences"
    document.addEventListener('click', (e) => {
      const t = e.target as Element | null;
      if (!t?.closest('[data-cc-open]')) return;
      e.preventDefault();
      toggle.checked = !!readChoice()?.analytics;
      dialog.showModal();
    });
    for (const b of document.querySelectorAll('[data-cc-accept]'))
      b.addEventListener('click', () => choose(true));
    for (const b of document.querySelectorAll('[data-cc-reject]'))
      b.addEventListener('click', () => choose(false));
    dialog.querySelector('[data-cc-save]')!.addEventListener('click', () => choose(toggle.checked));
    dialog.querySelector('[data-cc-close]')!.addEventListener('click', () => dialog.close());
    // a click on the backdrop closes it, without changing anything
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .cc {
    position: fixed;
    left: var(--gutter);
    bottom: var(--gutter);
    z-index: calc(var(--z-nav) + 2);
    display: grid;
    gap: var(--space-3);
    width: min(25rem, calc(100vw - 2 * var(--gutter)));
    padding: var(--space-5);
    border-radius: 20px;
    color: var(--ink);
    --lg-alpha: 0.78;
  }
  .cc[hidden] {
    display: none;
  }
  .cc-text {
    display: grid;
    gap: var(--space-2);
  }
  .cc-text a {
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .cc {
      left: var(--space-4);
      right: var(--space-4);
      bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
      width: auto;
    }
  }
  /* wide screens: a thin bar along the bottom, text left and the three choices right; it keeps
     clear of the depth rail like the footer does */
  @media (min-width: 900px) {
    .cc {
      left: var(--gutter);
      right: calc(var(--gutter) + 5.5rem);
      width: auto;
      max-width: 64rem;
      margin-inline: auto;
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: var(--space-6);
      padding: var(--space-4) 40px;
      border-radius: 28px;
    }
    .cc-text {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-1) var(--space-4);
    }
    .cc h2 {
      flex: none;
    }
    .cc .cc-actions {
      margin-top: 0;
    }
    .cc .cc-btn {
      min-width: 7.5rem;
    }
  }
  .cc h2,
  .cc-dialog h2 {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.1;
  }
  .cc h2 {
    font-size: var(--step-1);
  }
  .cc p,
  .cc-dialog > p {
    font-size: var(--step--1);
    color: rgb(232 244 248 / 0.85);
  }
  .cc a,
  .cc-dialog a {
    color: var(--bio);
  }

  /* every choice looks the same, in colour, size and type (KVKK Çerez Rehberi 2025, p. 30) */
  .cc-actions {
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .cc-btn {
    min-height: 44px;
    padding: 0.55rem 0.8rem;
    border: 1px solid rgb(232 244 248 / 0.28);
    border-radius: var(--radius-pill);
    background: rgb(232 244 248 / 0.08);
    color: var(--ink);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 500;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .cc-btn:hover {
    background: rgb(232 244 248 / 0.16);
  }
  .cc-btn:focus-visible {
    outline-offset: 2px;
    border-radius: var(--radius-pill);
  }

  .cc-dialog {
    /* the glass classes set position: relative; a modal sits fixed in the viewport */
    position: fixed;
    inset: 0;
    margin: auto;
    height: fit-content;
    max-height: calc(100svh - 2 * var(--space-5));
    overflow: auto;
    width: min(28rem, calc(100vw - 2 * var(--space-4)));
    padding: var(--space-6);
    border: 0;
    border-radius: 24px;
    color: var(--ink);
    --lg-alpha: 0.82;
  }
  .cc-dialog::backdrop {
    background: rgb(1 5 10 / 0.6);
    backdrop-filter: blur(4px);
  }
  .cc-dialog[open] {
    display: grid;
    gap: var(--space-4);
  }
  .cc-dialog h2 {
    font-size: var(--step-3);
    padding-right: var(--space-6);
  }
  .close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: rgb(232 244 248 / 0.08);
    color: inherit;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .cc-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cc-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-4);
    row-gap: var(--space-1);
    align-items: start;
    padding-block: var(--space-4);
    border-top: 1px solid var(--glass-border);
  }
  .cc-list li > div {
    display: grid;
    gap: var(--space-1);
  }
  .cc-list li > .cc-desc {
    grid-column: 1;
  }
  .cc-list li > .cc-switch {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .cc-name {
    font-weight: 600;
  }
  .cc-desc {
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  .cc-always {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-top: 0.2rem;
  }
  .cc-switch {
    appearance: none;
    position: relative;
    width: 2.75rem;
    height: 1.6rem;
    margin: 0;
    border: 1px solid rgb(232 244 248 / 0.28);
    border-radius: var(--radius-pill);
    background: rgb(232 244 248 / 0.08);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .cc-switch::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--ink);
    transform: translateY(-50%);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .cc-switch:checked {
    background: rgb(111 247 224 / 0.35);
    border-color: rgb(111 247 224 / 0.6);
  }
  .cc-switch:checked::after {
    transform: translate(1.15rem, -50%);
  }
  .cc-switch:focus-visible {
    border-radius: var(--radius-pill);
  }
</style>
