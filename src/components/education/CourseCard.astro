---
/**
 * A course, linking to its page. `featured`: a path's recommendation (large, with what you'll
 * be able to do, the length and Nev's fee); `row`: an alternative under it (one line);
 * `tile`: the searchable all-courses list.
 */
import { courseHref, formatFee, pathwayOf, searchText, type Course } from './courses';

interface Props {
  course: Course;
  variant: 'featured' | 'row' | 'tile';
  /** a label on a featured card, e.g. "Recommended" */
  badge?: string;
}
const { course, variant, badge } = Astro.props;
const d = course.data;
const tone = pathwayOf(d.pathway).tone;
const href = courseHref(course);
const facts = [d.facts.days, d.facts.depth && `to ${d.facts.depth}`, `age ${d.facts.age}+`].filter(
  Boolean,
);
---

{variant === 'featured' && (
  <a class={`card featured lg lg-dark lg-press tone-${tone}`} href={href}>
    {(badge || d.soon) && <span class="badge">{d.soon ? 'Coming soon' : badge}</span>}
    <span class="name">{d.name}</span>
    <span class="headline">{d.headline}</span>
    <span class="facts">
      {facts.map((f) => (
        <span class="fact">{f}</span>
      ))}
      {d.fee !== undefined && <span class="fact price">{formatFee(d.fee)}</span>}
    </span>
    <span class="arrow-link more">
      Course details{' '}
      <span class="arrow" aria-hidden="true">
        →
      </span>
    </span>
  </a>
)}
{variant === 'row' && (
  <a class={`card row tone-${tone}`} href={href}>
    <span class="name">
      {d.name}
      {d.soon && <span class="soon">Coming soon</span>}
    </span>
    <span class="row-meta">{facts.join(' · ')}</span>
    <span class="arrow" aria-hidden="true">
      →
    </span>
  </a>
)}
{variant === 'tile' && (
  <a
    class={`card tile lg lg-dark lg-press tone-${tone}`}
    href={href}
    data-course-search={searchText(course)}
  >
    <span class="name">
      {d.name}
      {d.short && d.short !== d.name && <span class="short">{d.short}</span>}
    </span>
    {d.soon && <span class="soon">Coming soon</span>}
    <span class="summary">{d.headline}</span>
    <span class="facts">
      {facts.map((f) => (
        <span class="fact">{f}</span>
      ))}
    </span>
  </a>
)}

<style>
  .tone-mint {
    --tone: 111 247 224;
  }
  .tone-amber {
    --tone: 255 196 107;
  }
  .tone-violet {
    --tone: 196 166 255;
  }
  .card {
    color: var(--ink);
    text-decoration: none;
  }
  .name {
    font-family: var(--font-display);
    line-height: 1.12;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .fact {
    padding: 0.25em 0.75em;
    border-radius: var(--radius-pill);
    font-size: 0.78rem;
    color: rgb(var(--tone));
    background: rgb(var(--tone) / 0.1);
    border: 1px solid rgb(var(--tone) / 0.28);
  }
  .price {
    color: var(--ink);
    background: rgb(232 244 248 / 0.06);
    border-color: rgb(232 244 248 / 0.2);
  }

  .featured {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    height: 100%;
    padding: var(--space-6);
    border-radius: 24px;
    box-shadow: inset 0 2px 0 rgb(var(--tone) / 0.6);
  }
  .featured .name {
    font-size: var(--step-3);
  }
  .headline {
    font-size: var(--step-0);
    color: rgb(232 244 248 / 0.86);
  }
  /* a course Nev will teach soon (his instructor rating is in progress) */
  .soon {
    align-self: flex-start;
    margin-left: 0.5em;
    padding: 0.15em 0.6em;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    vertical-align: 0.3em;
    color: rgb(var(--tone));
    box-shadow: inset 0 0 0 1px rgb(var(--tone) / 0.5);
  }
  .tile .soon {
    margin-left: 0;
  }
  .badge {
    justify-self: start;
    padding: 0.2em 0.7em;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-surface);
    background: rgb(var(--tone));
  }
  .more {
    justify-self: start;
    margin-top: var(--space-2);
    font-size: var(--step--1);
  }
  .featured:hover .more,
  .featured:focus-visible .more {
    background-size: 100% 1px;
  }
  .featured:hover .more .arrow,
  .featured:focus-visible .more .arrow {
    transform: translateX(4px);
  }

  /* one line: name, the facts, an arrow; rules between rows (set by the list) */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-1);
  }
  .row .name {
    font-size: var(--step-1);
  }
  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .row .arrow {
    color: rgb(var(--tone));
    transition: transform var(--dur-base) var(--ease-out);
  }
  .row:hover .arrow,
  .row:focus-visible .arrow {
    transform: translateX(4px);
  }
  .row:hover .name,
  .row:focus-visible .name {
    color: rgb(var(--tone));
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .row-meta {
      grid-row: 2;
    }
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-5);
    border-radius: 20px;
    box-shadow: inset 0 2px 0 rgb(var(--tone) / 0.5);
  }
  .tile .name {
    font-size: var(--step-1);
  }
  .short {
    display: block;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .summary {
    font-size: var(--step--1);
    color: rgb(232 244 248 / 0.8);
  }
  .tile .facts {
    margin-top: auto;
  }
</style>
