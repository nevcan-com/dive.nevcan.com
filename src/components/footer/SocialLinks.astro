---
/**
 * The row right before the footer card: Nev's accounts as line icons, and WhatsApp as the
 * direct line. Icons are simple outline drawings in the site's stroke style, not brand logos.
 */
import { social, whatsapp, type SocialLink } from '@/data/social';

const ICONS: Record<SocialLink['id'] | 'whatsapp', string> = {
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/>',
  facebook:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><path d="M15.5 8h-1.6c-1.1 0-1.9.8-1.9 1.9V20.5M9.5 12.5h5"/>',
  youtube:
    '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10.2 9.3v5.4l4.6-2.7z" fill="currentColor"/>',
  linkedin:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.3-2.6s2.2.9 2.2 2.6V16"/>',
  medium:
    '<circle cx="7.5" cy="12" r="4.5"/><ellipse cx="16" cy="12" rx="2.2" ry="4.3"/><path d="M20.8 8v8"/>',
  sketchfab: '<path d="M12 3 20 7.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5 12 12l8-4.5M12 12v9"/>',
  whatsapp:
    '<path d="M4.5 19.5 5.6 16A8 8 0 1 1 8.4 18.6z"/><path d="M9.3 8.8c.3-.4.8-.4 1 0l.6 1.3c.1.3 0 .6-.2.8l-.4.4c.5 1 1.3 1.8 2.3 2.3l.4-.4c.2-.2.5-.3.8-.2l1.3.6c.4.2.4.7 0 1-.6.6-1.4.9-2.2.6a7 7 0 0 1-4.2-4.2c-.3-.8 0-1.6.6-2.2z"/>',
};
---

<section class="social" aria-labelledby="social-title">
  <p class="label" id="social-title">
    Follow Nev
  </p>
  <ul class="links">
    {social.map((l) => (
      <li>
        <a
          class="icon"
          href={l.href}
          target="_blank"
          rel="me noopener"
          aria-label={l.label}
          title={l.label}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONS[l.id]} />
        </a>
      </li>
    ))}
  </ul>
  <a class="wa" href={whatsapp.href} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONS.whatsapp} />
    Message on WhatsApp
  </a>
</section>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4) var(--space-6);
    max-width: var(--content-max);
    margin: 0 auto var(--space-6);
  }
  .label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .links {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--ink);
    background: rgb(2 6 11 / 0.45);
    box-shadow: inset 0 0 0 1px rgb(232 244 248 / 0.16);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .icon:hover,
  .icon:focus-visible {
    color: var(--bio);
    box-shadow: inset 0 0 0 1px currentColor;
    transform: translateY(-2px);
  }
  .wa {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-pill);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--bio);
    text-decoration: none;
    background: rgb(2 6 11 / 0.45);
    box-shadow: inset 0 0 0 1px rgb(232 244 248 / 0.16);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .wa:hover,
  .wa:focus-visible {
    box-shadow: inset 0 0 0 1px currentColor;
  }
</style>
