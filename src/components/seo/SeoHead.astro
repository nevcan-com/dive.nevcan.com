---
import { t, type Locale } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  /** Absolute or root-relative share image, 1200×630; defaults to the reef photo (public/og-image.jpg) */
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, locale = 'en', image, noindex = false, jsonLd } = Astro.props;
/** Nev on a reef wall, torch on the soft corals (photo: Global Underwater Explorers) */
const DEFAULT_IMAGE = '/og-image.jpg';
const s = t(locale);
const fullTitle = title ? `${title} · ${s.site.shortName}` : s.site.name;
/** shared links: the homepage carries the full name */
const shareTitle = title ? fullTitle : s.site.shareName;
const desc = description ?? s.site.description;
// build.format 'file' makes the build-time path /about.html (and /index.html); the public URL is
// /about (and /)
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '');
const canonical = new URL(path || '/', Astro.site);
const ogImage = new URL(image ?? DEFAULT_IMAGE, Astro.site).href;
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={s.site.shareName} />
<meta property="og:title" content={shareTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical.href} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Nevcan Uludaş diving along a reef wall, his torch lighting red soft corals"
/>
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={shareTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
