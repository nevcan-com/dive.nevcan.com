---
/**
 * A full-bleed photograph at the top of a detail page (About, Education). The page's head then
 * rises onto its lower, darkened part (the page sets a negative top margin). The credit is set
 * vertically in the corner, like the homepage's clip credits.
 */
interface Props {
  src: string;
  srcset?: string;
  width: number;
  height: number;
  credit: string;
  /** CSS object-position: where the crop keeps the subject */
  position?: string;
  /** CSS height of the banner */
  bannerHeight?: string;
}
const {
  src,
  srcset,
  width,
  height,
  credit,
  position = '50% 50%',
  bannerHeight = 'clamp(24rem, 72svh, 46rem)',
} = Astro.props;
---

<div class="banner" style={`--banner-h: ${bannerHeight}; --banner-pos: ${position}`}>
  <img
    src={src}
    srcset={srcset}
    sizes={srcset ? '100vw' : undefined}
    alt=""
    width={width}
    height={height}
    fetchpriority="high"
  />
  <p class="banner-credit">{credit}</p>
</div>

<style>
  .banner {
    position: relative;
    height: var(--banner-h);
    overflow: hidden;
  }
  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--banner-pos);
  }
  .banner-credit {
    position: absolute;
    z-index: 1;
    left: max(6px, calc(var(--gutter) / 2 - 0.5em));
    bottom: var(--space-6);
    margin: 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(232 244 248 / 0.55);
    text-shadow: 0 0 8px rgb(1 5 10 / 0.6);
  }
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(1 8 16 / 0.55), transparent 22%),
      linear-gradient(to top, var(--depth-120) 2%, rgb(1 8 16 / 0.55) 30%, transparent 60%);
  }
</style>
