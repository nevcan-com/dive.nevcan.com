---
/**
 * Nev's GUE instructor card as a physical card: it tilts a little toward the cursor and turns
 * over when clicked (or Enter / Space). The season buttons below switch to earlier years' cards.
 * Under reduced motion it doesn't tilt and turns over without the animation.
 */
import { gueCards, GUE_RESUME } from '@/data/about';

const src = (slug: string, side: 'front' | 'back') => `/media/gue-cards/${slug}-${side}.webp`;
const label = (c: (typeof gueCards)[number]) => `GUE ${c.rating.toLowerCase()} card ${c.season}`;
const current = gueCards[0]!;
---

<div class="gue-card" data-gue-card data-cards={JSON.stringify(gueCards)}>
  <div class="stage">
    <button
      class="card"
      type="button"
      aria-pressed="false"
      aria-label={`${label(current)}. Turn it over`}
      data-card-button
    >
      <span class="tilt" data-tilt>
        <span class="flip">
          <img
            class="face front"
            src={src(current.slug, 'front')}
            alt={`${label(current)}, front: Nevcan Uludas, instructor #20397, ${current.rating}, expires ${current.expires}`}
            width="511"
            height="324"
            loading="lazy"
            decoding="async"
            data-front
          />
          <img
            class="face back"
            src={src(current.slug, 'back')}
            alt={`${label(current)}, back (photo: ${current.photo})`}
            width="511"
            height="324"
            loading="lazy"
            decoding="async"
            data-back
          />
        </span>
        <span class="glare" aria-hidden="true"></span>
      </span>
    </button>
    <p class="hint" aria-hidden="true">
      <span class="hint-mouse">Click to turn it over</span>
      <span class="hint-touch">Tap to turn it over</span>
    </p>
  </div>

  <div class="info">
    <p class="season" data-season>
      {current.season}
    </p>
    <p class="rating" data-rating>
      GUE {current.rating}
    </p>
    <p class="meta">
      Instructor #20397 · <span data-expires>valid until {current.expires}</span>
    </p>
    {gueCards.length > 1 && (
      <div class="seasons" role="group" aria-label="Earlier cards">
        {gueCards.map((c, i) => (
          <button
            type="button"
            class="season-btn"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-season-index={i}
          >
            {c.season.replace(/^20(\d\d)–20(\d\d)$/, '’$1–’$2')}
          </button>
        ))}
      </div>
    )}
    <a class="verify arrow-link" href={GUE_RESUME} target="_blank" rel="noopener">
      Instructor résumé on gue.com{' '}
      <span class="arrow" aria-hidden="true">
        →
      </span>
    </a>
  </div>
</div>

<script>
  interface Card {
    season: string;
    slug: string;
    rating: string;
    expires: string;
    photo: string;
  }
  const MAX_TILT = 7; // degrees

  for (const root of document.querySelectorAll<HTMLElement>('[data-gue-card]')) {
    const cards = JSON.parse(root.dataset.cards ?? '[]') as Card[];
    const button = root.querySelector<HTMLButtonElement>('[data-card-button]')!;
    const tilt = root.querySelector<HTMLElement>('[data-tilt]')!;
    const front = root.querySelector<HTMLImageElement>('[data-front]')!;
    const back = root.querySelector<HTMLImageElement>('[data-back]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let flipped = false;
    let index = 0;

    const label = (c: Card) => `GUE ${c.rating.toLowerCase()} card ${c.season}`;
    const setFlipped = (on: boolean) => {
      flipped = on;
      root.classList.toggle('is-flipped', on);
      button.setAttribute('aria-pressed', String(on));
      button.setAttribute(
        'aria-label',
        `${label(cards[index]!)}. ${on ? 'Turn it back' : 'Turn it over'}`,
      );
    };
    button.addEventListener('click', () => setFlipped(!flipped));

    // a slight tilt toward the cursor (mouse and pen only; touch just taps to turn it over)
    button.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch' || reduced.matches) return;
      const r = button.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      tilt.style.setProperty('--ry', `${(x * 2 * MAX_TILT).toFixed(2)}deg`);
      tilt.style.setProperty('--rx', `${(-y * 2 * MAX_TILT).toFixed(2)}deg`);
      tilt.style.setProperty('--gx', `${((x + 0.5) * 100).toFixed(1)}%`);
      tilt.style.setProperty('--gy', `${((y + 0.5) * 100).toFixed(1)}%`);
      root.classList.add('is-tilting');
    });
    button.addEventListener('pointerleave', () => {
      tilt.style.setProperty('--rx', '0deg');
      tilt.style.setProperty('--ry', '0deg');
      root.classList.remove('is-tilting');
    });

    // earlier seasons
    const seasonButtons = root.querySelectorAll<HTMLButtonElement>('[data-season-index]');
    for (const b of seasonButtons) {
      b.addEventListener('click', () => {
        index = Number(b.dataset.seasonIndex);
        const c = cards[index]!;
        for (const o of seasonButtons) o.setAttribute('aria-pressed', String(o === b));
        root.classList.add('is-swapping');
        window.setTimeout(
          () => {
            front.src = `/media/gue-cards/${c.slug}-front.webp`;
            back.src = `/media/gue-cards/${c.slug}-back.webp`;
            front.alt = `${label(c)}, front: Nevcan Uludas, instructor #20397, ${c.rating}, expires ${c.expires}`;
            back.alt = `${label(c)}, back (photo: ${c.photo})`;
            root.querySelector('[data-season]')!.textContent = c.season;
            root.querySelector('[data-rating]')!.textContent = `GUE ${c.rating}`;
            root.querySelector('[data-expires]')!.textContent =
              index === 0 ? `valid until ${c.expires}` : `expired ${c.expires}`;
            setFlipped(false);
            root.classList.remove('is-swapping');
          },
          reduced.matches ? 0 : 180,
        );
      });
    }
  }
</script>

<style>
  .gue-card {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 760px) {
    .gue-card {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .stage {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    perspective: 1100px;
  }
  .card {
    display: block;
    width: 100%;
    max-width: 26rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    /* the halves are ~1.58:1, a real card's proportions */
    aspect-ratio: 511 / 324;
    border-radius: 14px;
  }
  .card:focus-visible {
    outline: 2px solid var(--bio);
    outline-offset: 6px;
  }
  .tilt {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .is-tilting .tilt {
    transition-duration: 0.12s;
  }
  .flip {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transition:
      transform 0.8s cubic-bezier(0.45, 0, 0.2, 1),
      opacity 0.18s ease;
  }
  .is-flipped .flip {
    transform: rotateY(180deg);
  }
  .is-swapping .flip {
    opacity: 0;
  }
  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 14px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      0 18px 40px rgb(0 0 0 / 0.45),
      0 4px 10px rgb(0 0 0 / 0.3);
  }
  .back {
    transform: rotateY(180deg);
  }
  /* a soft sheen that follows the cursor, like light on a laminated card */
  .glare {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 50%),
      rgb(255 255 255 / 0.22),
      transparent 55%
    );
    mix-blend-mode: soft-light;
    transform: translateZ(1px);
  }
  .is-tilting .glare {
    opacity: 1;
  }
  .hint {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .hint-touch {
    display: none;
  }
  @media (hover: none) {
    .hint-mouse {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }

  .info {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .season {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: var(--tracking-caps);
    color: var(--bio);
  }
  .rating {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.05;
  }
  .meta {
    color: var(--ink-muted);
  }
  .seasons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .season-btn {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.04);
    color: rgb(232 244 248 / 0.75);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .season-btn:hover {
    color: #fff;
  }
  .season-btn[aria-pressed='true'] {
    border-color: rgb(111 247 224 / 0.6);
    background: rgb(111 247 224 / 0.12);
    color: var(--bio);
  }
  .verify {
    margin-top: var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .tilt,
    .flip {
      transition: none;
    }
  }
</style>
